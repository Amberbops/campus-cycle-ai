# CampusCycle AI — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=campuscycle-items-dev

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
DYNAMO_USERS_TABLE=CampusCycle_Users
DYNAMO_ITEMS_TABLE=CampusCycle_Items
DYNAMO_DEMAND_TABLE=CampusCycle_DemandRequests
DYNAMO_MATCHES_TABLE=CampusCycle_Matches
DYNAMO_TASKS_TABLE=CampusCycle_Tasks
DYNAMO_IMPACT_TABLE=CampusCycle_ImpactEvents
DYNAMO_AUDIT_TABLE=CampusCycle_AuditEvents
DYNAMO_CONFIG_TABLE=CampusCycle_Config

# ── Amazon Bedrock ────────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_TEXT_MODEL_ID=amazon.nova-pro-v1:0
 
# ── Backup Multimodal AI (Google Gemini) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.6-flash

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_CONFIDENCE_THRESHOLD=0.55
AGENT_MAX_TOKENS=1024
AGENT_TEMPERATURE=0.2

# ── App ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=DEBUG
